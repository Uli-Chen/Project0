# File path, not a database URL. Relative paths resolve from the project root.
# On a server, use an absolute path on persistent local storage.
DATABASE_PATH=./data/app.db

# Used by npm run db:backup. Copy completed backups off the server separately.
DATABASE_BACKUP_DIR=./backups

# Optional canonical app origin behind a reverse proxy, e.g. https://write.example.com.
# Requests must come from this exact origin. Leave empty for local development.
APP_ORIGIN=

# New account creation is paused by default. Set true and restart to reopen.
REGISTRATION_ENABLED=false

# 题库改版：默认关闭；速刷和检查点依赖题库开关。
QUESTION_BANK_ENABLED=false
QUICK_ENABLED=false
CHECKPOINTS_ENABLED=false
FOCUS_ENABLED=false

# 模型接口（OpenAI 兼容的 /chat/completions）。密钥只写在 .env.local，不进 Git。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Agent Tutor remains off until real-model and trial acceptance.
TUTOR_V2_ENABLED=false
# Optional backup retention. Unset means do not delete backups.
# DATABASE_BACKUP_KEEP_DAYS=
